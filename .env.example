# ---------------------------------------------------------------------------
# bank_demo - local environment
# Copy to .env. Nothing in this file is ever sent to the browser.
# ---------------------------------------------------------------------------

# --- This app ---
PORT=4000
NODE_ENV=development

# --- Placeholder branding (swap for real assets later) ---
BANK_NAME=Bank Demo Nusantara
BANK_SHORT=BDN
BANK_TAGLINE=Melayani Negeri, Kebanggaan Bangsa (placeholder)
MOBILE_APP_NAME=wndr
SHOW_DEMO_BANNER=true

# --- ADA Solutions ingest API (sibling ADA_project) ---
ADA_BASE_URL=http://localhost:8000
ADA_API_KEY=demo-wallet-key-change-me
ADA_TENANT_SLUG=demo-wallet
ADA_TIMEOUT_MS=4000
ADA_MAX_BATCH_SIZE=500

# Fail the user action when ADA is down? Keep false: ADA is never in the
# critical path of a banking transaction (ADA_project README, requirement 4).
ADA_FAIL_OPEN=true

# --- Desktop portal session ---
# Idle logout, matching a real retail internet-banking session.
SESSION_IDLE_TIMEOUT_MS=900000
# Show the expected e-Secure token code on screen (demo convenience).
DEMO_SHOW_TOKEN=true

# --- SDK transport (mobile surface) ---
SDK_FLUSH_INTERVAL_MS=1500
SDK_MAX_QUEUE=500
SDK_MAX_RETRIES=3

# --- Recommendation pull-back loop ---
RECS_POLL_INTERVAL_MS=10000
RECS_AUTO_ACK=true

# --- OPTIONAL demo-only convenience -------------------------------------
# ADA returns recommendations keyed by user_pseudonym and exposes no reverse
# lookup. Setting BOTH of these lets bank_demo recompute the same pseudonym
# locally (HMAC_SHA256(secret, "<tenant_id>:<user_ref>")) so an offer can be
# routed to the right demo user on stage. Leave blank and every approved
# recommendation lands in a shared offers inbox instead.
# Values come from ADA_project/.env (PSEUDONYM_HMAC_SECRET) and the tenants
# table (id of tenant_slug=demo-wallet).
ADA_PSEUDONYM_HMAC_SECRET=
ADA_TENANT_ID=
